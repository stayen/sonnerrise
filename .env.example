# Sonnerrise Environment Configuration
# Copy this file to .env and adjust values before running docker-compose

# =============================================================================
# Database Settings
# =============================================================================

# MySQL root password (used for initial database setup)
MYSQL_ROOT_PASSWORD=changeme-root-password

# Application database name
MYSQL_DATABASE=sonnerrise

# Application database user
MYSQL_USER=sonnerrise

# Application database password
MYSQL_PASSWORD=changeme-db-password

# MySQL port (change if 3306 is already in use)
MYSQL_PORT=3306

# =============================================================================
# Web Interface Settings
# =============================================================================

# Web server port (change if 5000 is already in use)
WEB_PORT=5000

# Flask secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-secret-key

# =============================================================================
# Notes
# =============================================================================
# - Never commit .env to version control
# - Use strong, unique passwords in production
# - SECRET_KEY should be a random string of at least 32 characters
